---
interface Props {
	title: string;
	body: string;
	href: string;
}

const { href, title, body } = Astro.props;
---

<li class="link-card border-4 rounded-lg border-mech-500 bg-mech-100 color-mech-500 hover:bg-mech-500 hover:text-mech-100 flex p-1 list-none bg none">
	<a href={href} class=" w-full">
		<h2 class="font-bold text-xl">
			{title}
			<span>&rarr;</span>
		</h2>
		<p class="mt-2">
			{body}
		</p>
	</a>
</li>
<style>
	.link-card {
		background-position: 100%;
		transition: background-position 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		#box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
	}
	.link-card > a {
		text-decoration: none;
		line-height: 1.4;
		padding: calc(1.5rem - 1px);
	}
	h2 {
		transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
	p {
		transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.link-card:is(:hover, :focus-within) {
		#background-image: var(--accent-gradient);
	}
	.link-card:is(:hover, :focus-within) a {
                background-color: rgb(var(--accent-dark));
	}
</style>

