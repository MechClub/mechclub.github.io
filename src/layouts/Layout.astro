---
import Head from './Head.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import '@fontsource/share-tech';
import '@fontsource/poppins';

const {
    title = 'Mech Club',
    description = 'We are Mech Club at the University of Toronto, ready to welcome all of you into our community! We are here to serve the mechanical engineering students of UofT!',
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <Head {title} {description}/>
    <body class="text-mech-500 bg-mech-100">
        <Navbar />
	<slot/>
        <Footer />
    </body>
</html>
<style is:global>
  html {
    font-family: system-ui, sans-serif;
    background-color: rgb(var(--accent-light));
    background-size: 224px;
  }
  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      Cascadia Code,
      monospace;
  }
  @font-face {
    font-family: 'FontAwesome';
    src: url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css') format('woff');
  }
  .link-card-grid {
    grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
  }

</style>
